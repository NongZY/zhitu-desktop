# -----------------------------------------------------------------------------
# Compose / application
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=smart-learning
APP_NAME=智能自适应学习系统
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
TIMEZONE=Asia/Shanghai

# Host ports (change these when a port is already occupied)
FRONTEND_PORT=8080
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Authentication. Replace both secrets before any shared or production deployment.
SECRET_KEY=change-this-to-a-long-random-string-at-least-32-characters
JWT_SECRET_KEY=change-this-to-another-long-random-string-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Bootstrap administrator (created only when the backend bootstrap command supports it)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=系统管理员

# -----------------------------------------------------------------------------
# PostgreSQL
# Keep the password URL-safe, or URL-encode it in DATABASE_URL below.
# -----------------------------------------------------------------------------
POSTGRES_DB=smart_learning
POSTGRES_USER=smart_learning
POSTGRES_PASSWORD=smart_learning_dev_password
DATABASE_URL=postgresql+psycopg://smart_learning:smart_learning_dev_password@postgres:5432/smart_learning
SYNC_DATABASE_URL=postgresql+psycopg://smart_learning:smart_learning_dev_password@postgres:5432/smart_learning

# -----------------------------------------------------------------------------
# Redis / Celery
# -----------------------------------------------------------------------------
REDIS_PASSWORD=smart_learning_redis_password
REDIS_URL=redis://:smart_learning_redis_password@redis:6379/0
CELERY_BROKER_URL=redis://:smart_learning_redis_password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:smart_learning_redis_password@redis:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# -----------------------------------------------------------------------------
# MinIO object storage
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=smartlearning
MINIO_ROOT_PASSWORD=smart_learning_minio_password
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=smartlearning
MINIO_SECRET_KEY=smart_learning_minio_password
MINIO_BUCKET=textbooks
MINIO_SECURE=false

# -----------------------------------------------------------------------------
# PDF / OCR / RAG
# The application can start without external model keys. Configure a provider to
# enable model-backed question answering and question generation.
# -----------------------------------------------------------------------------
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_MB=200
OCR_ENABLED=false
PADDLE_OCR_LANG=ch
PDF_PARSE_PAGE_BATCH_SIZE=20

VECTOR_STORE=chroma
CHROMA_PERSIST_DIRECTORY=/app/data/chroma
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.45

LLM_PROVIDER=disabled
LLM_MODEL=
LLM_API_KEY=
LLM_API_URL=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
QIANFAN_ACCESS_KEY=
QIANFAN_SECRET_KEY=

# Frontend build-time API prefix. Keep this relative when the frontend and API
# are exposed through the included Nginx configuration.
VITE_API_BASE_URL=/api/v1
